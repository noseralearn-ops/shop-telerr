/* Palette: Coklat Tua (#3d2b1f), Cream (#f5ebe0), Coklat Muda (#8b5e3c) */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Georgia', serif;
    background-color: #f5ebe0; /* Cream */
    color: #3d2b1f;
    line-height: 1.6;
}

.container {
    max-width: 1000px;
    margin: auto;
    padding: 20px;
}

/* Navigasi */
nav {
    background-color: #3d2b1f; /* Coklat Tua */
    padding: 15px 0;
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1000px;
    margin: auto;
    padding: 0 20px;
}

nav a {
    color: #f5ebe0;
    text-decoration: none;
    margin-left: 20px;
    font-weight: bold;
    font-size: 0.9rem;
}

nav a.logo {
    font-size: 1.5rem;
    letter-spacing: 2px;
    margin-left: 0;
}

/* Home / Hero */
header {
    height: 100vh;
    background-color: #3d2b1f;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: #f5ebe0;
}

.hero h1 {
    font-size: 5rem;
    margin-bottom: 10px;
}

.hero p {
    font-style: italic;
    font-size: 1.2rem;
    margin-bottom: 30px;
}

.btn {
    padding: 10px 25px;
    background-color: #8b5e3c;
    color: white;
    text-decoration: none;
    border-radius: 5px;
    transition: 0.3s;
}

/* Sections */
section {
    padding: 100px 0;
}

h2 {
    text-align: center;
    margin-bottom: 40px;
    font-size: 2.5rem;
    color: #3d2b1f;
    border-bottom: 2px solid #8b5e3c;
    display: inline-block;
    width: 100%;
}

/* About */
.vision-mission {
    display: flex;
    gap: 20px;
    margin-top: 30px;
}

.box {
    flex: 1;
    background: #ede0d4;
    padding: 20px;
    border-radius: 8px;
    border: 1px solid #8b5e3c;
}

/* Product Cards */
.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
}

.card {
    background: white;
    border-radius: 10px;
    overflow: hidden;
    padding: 20px;
    border: 1px solid #8b5e3c;
    text-align: center;
    box-shadow: 4px 4px 0px #8b5e3c;
}

.card img {
    width: 100%;
    border-radius: 5px;
}

.price {
    font-size: 1.5rem;
    font-weight: bold;
    color: #8b5e3c;
    margin: 10px 0;
}

.date-info {
    font-size: 0.8rem;
    display: flex;
    flex-direction: column;
}

/* Form */
.form-container {
    background: #ede0d4;
    padding: 30px;
    border-radius: 10px;
    margin-top: 40px;
}

input, textarea {
    width: 100%;
    padding: 12px;
    margin-bottom: 15px;
    border: 1px solid #8b5e3c;
    background: #f5ebe0;
}

button {
    background-color: #3d2b1f;
    color: white;
    border: none;
    padding: 12px 30px;
    cursor: pointer;
    width: 100%;
    font-size: 1rem;
}

.social-buttons {
    text-align: center;
    margin-bottom: 20px;
}

.social-buttons a {
    display: inline-block;
    padding: 10px 20px;
    margin: 5px;
    text-decoration: none;
    color: white;
    border-radius: 5px;
}

.btn-wa { background-color: #25d366; }
.btn-ig { background-color: #e1306c; }

/* Result Box */
.result-box {
    display: none;
    margin-top: 20px;
    padding: 20px;
    background: white;
    border-left: 5px solid #3d2b1f;
}

footer {
    background-color: #3d2b1f;
    color: #f5ebe0;
    text-align: center;
    padding: 30px;
}
